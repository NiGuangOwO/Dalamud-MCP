<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ProtocolSmokeTest</AssemblyName>
    <RootNamespace>ProtocolSmokeTest</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Compiles the REAL transport/protocol sources. They deliberately have no Dalamud
       dependency, which is exactly what makes this test possible. -->
  <ItemGroup>
    <Compile Include="..\..\src\DalamudMCP\Mcp\Json.cs" Link="Mcp\Json.cs" />
    <Compile Include="..\..\src\DalamudMCP\Mcp\MiniHttp.cs" Link="Mcp\MiniHttp.cs" />
    <Compile Include="..\..\src\DalamudMCP\Mcp\ToolRegistry.cs" Link="Mcp\ToolRegistry.cs" />
    <Compile Include="..\..\src\DalamudMCP\Mcp\McpServer.cs" Link="Mcp\McpServer.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
