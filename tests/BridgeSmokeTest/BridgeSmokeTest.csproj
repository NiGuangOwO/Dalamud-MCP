<Project Sdk="Microsoft.NET.Sdk">

  <!--
    End-to-end test for the stdio bridge: hosts the REAL MCP server in-process,
    launches the REAL bridge as a child process, and speaks newline-delimited
    JSON-RPC to it over stdin/stdout exactly as an MCP host would.

    The MCP transport sources are linked (not copied) so this exercises the same
    code the plugin ships: src\DalamudMCP\Mcp\{Json,MiniHttp,ToolRegistry,McpServer}.cs
    have no Dalamud dependencies, which is what makes that possible.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\DalamudMCP\Mcp\Json.cs" Link="Mcp\Json.cs" />
    <Compile Include="..\..\src\DalamudMCP\Mcp\MiniHttp.cs" Link="Mcp\MiniHttp.cs" />
    <Compile Include="..\..\src\DalamudMCP\Mcp\ToolRegistry.cs" Link="Mcp\ToolRegistry.cs" />
    <Compile Include="..\..\src\DalamudMCP\Mcp\McpServer.cs" Link="Mcp\McpServer.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
