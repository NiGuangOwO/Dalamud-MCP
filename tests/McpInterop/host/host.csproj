<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>interophost</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- The REAL transport + protocol sources, exactly as the plugin ships them. This host exists
       so an INDEPENDENT MCP client implementation (the official TypeScript SDK) can talk to the
       actual server; see ..\run-interop.ps1 for why that is worth a separate project. -->
  <ItemGroup>
    <Compile Include="..\..\..\src\DalamudMCP\Mcp\Json.cs" Link="Mcp\Json.cs" />
    <Compile Include="..\..\..\src\DalamudMCP\Mcp\MiniHttp.cs" Link="Mcp\MiniHttp.cs" />
    <Compile Include="..\..\..\src\DalamudMCP\Mcp\ToolRegistry.cs" Link="Mcp\ToolRegistry.cs" />
    <Compile Include="..\..\..\src\DalamudMCP\Mcp\McpServer.cs" Link="Mcp\McpServer.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
